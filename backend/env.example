# Copy this file to .env and fill in real values before starting the server.

# Server
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS + the
# post-Google-OAuth redirect target. First entry is used for the OAuth
# redirect. Example (prod): https://docugenie-ai.netlify.app
FRONTEND_URL=http://localhost:5173

# Public base URL of this backend (used to build the Google OAuth callback
# URL). Example (prod): https://s81-docu-genie.onrender.com
BACKEND_URL=http://localhost:3001

# Database
DATABASE_URL=./database.sqlite

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace-with-a-long-random-secret

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI providers
# Used for chat generation (OpenRouter) and for document/query embeddings (Google).
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
